{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all"
  ],
  "timezone": "America/Chicago",
  "schedule": [
    "* * * * 6"
  ],
  "prConcurrentLimit": 1,
  "packageRules": [
    {
      "description": "typescript-eslint supports TypeScript below 6.1",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<6.1"
    }
  ]
}
