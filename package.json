{
  "name": "pupload-server",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "esbuild 'web/*.tsx' 'web/*.html' --bundle --minify --format=esm --loader:.html=copy --outdir=dist/web",
    "dev": "npm run build -- --watch",
    "prestart": "npm run build",
    "start": "node server/index.ts",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "preact": "11.2.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
