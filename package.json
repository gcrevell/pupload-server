{
  "name": "pupload-server",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "esbuild 'web/*.css' 'web/auth/*.tsx' 'web/auth/*.css' 'web/auth/*.html' --outbase=web --bundle --minify --format=esm --loader:.html=copy --loader:.css=copy --outdir=dist/web",
    "dev": "npm run build -- --watch",
    "prestart": "npm run build",
    "start": "node server/index.ts",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "dependencies": {
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.11",
    "esbuild": "0.28.2",
    "eslint": "10.16.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
